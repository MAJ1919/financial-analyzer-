# ======================================================
# Backend Environment Variables — copy to .env and fill
# ======================================================

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Anon/public key — required for user-scoped requests that run under RLS
SUPABASE_ANON_KEY=your-anon-key-here

# CORS — comma-separated list of allowed frontend origins.
# Origins are scheme://host[:port] with NO trailing slash and no path.
# Production example:
#   CORS_ORIGINS=https://financial-analyzer.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Optional: anchored regex for origins with unpredictable hostnames — chiefly
# Vercel preview deploys, which get a fresh domain per branch. Leave empty to
# disable. Anchor it: a bare "vercel\.app" would also match evil-vercel.app.com.
# CORS_ORIGIN_REGEX=https://my-app-git-[a-z0-9-]+-myscope\.vercel\.app
CORS_ORIGIN_REGEX=

# App
APP_ENV=development

# ------------------------------------------------------------------
# Deployment (Render): do NOT ship this file — set these in the Render
# dashboard instead. See render.yaml at the repo root; the values marked
# `sync: false` there are exactly the ones you'll be prompted for.
# ------------------------------------------------------------------
