# ======================================================
# Frontend Environment Variables — copy to .env and fill
# ======================================================

# FastAPI backend URL — must end in /api (the routers are mounted under /api).
# Local dev:  http://localhost:8000/api
# Production: https://<your-render-service>.onrender.com/api
#
# NOTE: VITE_* vars are inlined at BUILD time, so this must be set in the Vercel
# project settings (not just here) and the project REDEPLOYED for a change to
# take effect. vite.config.js fails the build on Vercel if it is missing or
# still points at localhost.
VITE_API_URL=http://localhost:8000/api

# Supabase (use ANON key for frontend — NOT service role key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
